  {\end{vspcallout}}

\newcommand{\vspaccent}[1]{{\color{VSPAccent}\bfseries #1}}
\newcommand{\vspmuted}[1]{{\color{VSPMuted}#1}}

\lstdefinestyle{vsp}{
  basicstyle=\ttfamily\vspcodefont,
  backgroundcolor=\color{VSPCodeBackground},
  keywordstyle=\color{blue!70!black}\bfseries,
  commentstyle=\color{VSPGreen},
  stringstyle=\color{VSPOrange},
  numberstyle=\fontsize{4.5}{5.5}\selectfont\color{VSPMuted},
  numbers=left,
  numbersep=7pt,
  frame=single,
  rulecolor=\color{VSPTeal},
  framerule=.4pt,
  framesep=6pt,
  showstringspaces=false,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true
}
\lstset{style=vsp}

\AtBeginEnvironment{frame}{\justifying}
\mode<all>
